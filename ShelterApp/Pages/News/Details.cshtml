@page
@model ShelterApp.Pages.News.DetailsModel
@{
    ViewData["Title"] = Model.ViewModel.News.Title;
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">Главная</a></li>
        <li class="breadcrumb-item"><a asp-page="/News/Index">Новости</a></li>
        <li class="breadcrumb-item active">@Model.ViewModel.News.Title</li>
    </ol>
</nav>

<div class="row">
    <div class="col-lg-8 mx-auto">
        <h1 class="mb-3">@Model.ViewModel.News.Title</h1>
        <p class="text-muted"><small>@Model.ViewModel.News.PublishedAt.ToString("dd.MM.yyyy")</small></p>

        @if (!string.IsNullOrEmpty(Model.ViewModel.News.ImagePath))
        {
            <img src="@Model.ViewModel.News.ImagePath" class="img-fluid rounded shadow-sm mb-4" alt="@Model.ViewModel.News.Title" onerror="this.src='/images/no-photo.png'" />
        }

        <div class="mb-4" style="white-space: pre-wrap;">@Model.ViewModel.News.Content</div>

        @if (Model.ViewModel.RelatedAnimal != null)
        {
            <div class="alert alert-secondary text-center">
                <p class="mb-2">Эта новость связана с животным <strong>@Model.ViewModel.RelatedAnimal.Name</strong></p>
                <a asp-page="/Animals/Details" asp-route-id="@Model.ViewModel.RelatedAnimal.Id" class="btn btn-outline-primary">Перейти к карточке животного</a>
            </div>
        }

        <hr class="my-4" />

        <a asp-page="/News/Index" class="btn btn-outline-secondary">← Все новости</a>
    </div>
</div>