@page
@model ShelterApp.Pages.News.IndexModel
@{
    ViewData["Title"] = "Новости";
}

<h1 class="mb-4">Новости приюта</h1>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    
    <!-- Карточка 1>
    <div class="col">
        <div class="card h-100 shadow-sm news-card">
            <img src="~/images/timosha.jpg" class="card-img-top" alt="Тимоша" style="height:240px;object-fit:cover;" onerror="this.src='/images/no-photo.png'" />
            <div class="card-body">
                <h5 class="card-title">Вакцинация Тимоши</h5>
                <p class="text-muted mb-2"><small>12 октября 2026</small></p>
                <p class="card-text">Наш малыш Тимоша прошёл плановую вакцинацию. Чувствует себя отлично, кушает хорошо и уже готов искать новый дом.</p>
            </div>
            <div class="card-footer bg-white border-0">
                <a asp-page="/News/Details" class="btn btn-primary w-100">Читать далее</a>
            </div>
        </div>
    </div>

    <!--Карточка 2>
    <div class="col">
        <div class="card h-100 shadow-sm news-card">
            <img src="~/images/barsik.jpg" class="card-img-top" alt="Барсик" style="height:240px;object-fit:cover;" onerror="this.src='/images/no-photo.png'" />
            <div class="card-body">
                <h5 class="card-title">Барсик нашёл хозяина!</h5>
                <p class="text-muted mb-2"><small>5 октября 2026</small></p>
                <p class="card-text">Отличные новости! Наш рыжий Барсик наконец-то обрёл любящую семью. Желаем им долгих лет вместе.</p>
            </div>
            <div class="card-footer bg-white border-0">
                <a asp-page="/News/Details" class="btn btn-primary w-100">Читать далее</a>
            </div>
        </div>
    </div>

    <!--Карточка 3>
    <div class="col">
        <div class="card h-100 shadow-sm news-card">
            <img src="~/images/murka.jpg" class="card-img-top" alt="Мурка" style="height:240px;object-fit:cover;" onerror="this.src='/images/no-photo.png'" />
            <div class="card-body">
                <h5 class="card-title">Субботник в приюте</h5>
                <p class="text-muted mb-2"><small>1 октября 2026</small></p>
                <p class="card-text">Приглашаем всех желающих на субботник! Поможем приюту подготовиться к зиме, приведём в порядок вольеры и накормим животных.</p>
            </div>
            <div class="card-footer bg-white border-0">
                <a asp-page="/News/Details" class="btn btn-primary w-100">Читать далее</a>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <style>
        .news-card {
            transition: box-shadow 0.3s ease, transform 0.3s ease;
        }
        .news-card:hover {
            box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.15) !important;
            transform: translateY(-2px);
        }
    </style>
}