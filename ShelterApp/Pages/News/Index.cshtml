@page
@model ShelterApp.Pages.News.IndexModel
@{
    ViewData["Title"] = "Новости";
}

<h1 class="mb-4">Новости приюта</h1>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">

    <!-- Карточка 1 -->
    <div class="col">
        <div class="card h-100 shadow-sm news-card">
            <img src="~/images/no-photo.png" class="card-img-top" alt="Заглушка" style="height:240px;object-fit:cover;" />
            <div class="card-body">
                <h5 class="card-title">Заголовок новости 1</h5>
                <p class="text-muted mb-2"><small>01.01.2026</small></p>
                <p class="card-text">Краткое описание новости-заглушки. Здесь будет располагаться текст о жизни приюта, событиях или питомцах.</p>
            </div>
            <div class="card-footer bg-white border-0">
                <a asp-page="/News/Details" class="btn btn-primary w-100">Читать далее</a>
            </div>
        </div>
    </div>

    <!-- Карточка 2 -->
    <div class="col">
        <div class="card h-100 shadow-sm news-card">
            <img src="~/images/no-photo.png" class="card-img-top" alt="Заглушка" style="height:240px;object-fit:cover;" />
            <div class="card-body">
                <h5 class="card-title">Заголовок новости 2</h5>
                <p class="text-muted mb-2"><small>02.01.2026</small></p>
                <p class="card-text">Краткое описание новости-заглушки. Здесь будет располагаться текст о жизни приюта, событиях или питомцах.</p>
            </div>
            <div class="card-footer bg-white border-0">
                <a asp-page="/News/Details" class="btn btn-primary w-100">Читать далее</a>
            </div>
        </div>
    </div>

    <!-- Карточка 3 -->
    <div class="col">
        <div class="card h-100 shadow-sm news-card">
            <img src="~/images/no-photo.png" class="card-img-top" alt="Заглушка" style="height:240px;object-fit:cover;" />
            <div class="card-body">
                <h5 class="card-title">Заголовок новости 3</h5>
                <p class="text-muted mb-2"><small>03.01.2026</small></p>
                <p class="card-text">Краткое описание новости-заглушки. Здесь будет располагаться текст о жизни приюта, событиях или питомцах.</p>
            </div>
            <div class="card-footer bg-white border-0">
                <a asp-page="/News/Details" class="btn btn-primary w-100">Читать далее</a>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <style>
        .news-card {
            transition: box-shadow 0.3s ease, transform 0.3s ease;
        }

            .news-card:hover {
                box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.15) !important;
                transform: translateY(-2px);
            }
    </style>
}