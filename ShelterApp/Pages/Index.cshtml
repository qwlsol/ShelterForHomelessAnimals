@page
@model ShelterApp.Pages.IndexModel
@{
    ViewData["Title"] = "Главная";
}

<section class="hero text-center py-5 bg-light rounded mb-4">
    <h1 class="mt-3">Приют «Шанс на жизнь»</h1>
    <p class="lead">Найдите верного друга — собаку или кошку из приюта.</p>
    <p>
        <strong>Телефон:</strong> +7 (900) 000-00-00 &nbsp;|&nbsp;
        <strong>Email:</strong> info@shans-life.ru &nbsp;|&nbsp;
        <strong>Адрес:</strong> г. Вышний Волочёк, ул. Красноармейская, 38
    </p>
</section>

<div class="card mb-4 shadow-sm bg-light">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-2">
                <label class="form-label">Вид</label>
                <select name="species" class="form-select">
                    <option value="">Все</option>
                    <option value="0" selected="@(Model.ViewModel.Filter.Species == 0)">Собака</option>
                    <option value="1" selected="@(Model.ViewModel.Filter.Species == 1)">Кошка</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label">Пол</label>
                <select name="gender" class="form-select">
                    <option value="">Все</option>
                    <option value="0" selected="@(Model.ViewModel.Filter.Gender == 0)">Мальчик</option>
                    <option value="1" selected="@(Model.ViewModel.Filter.Gender == 1)">Девочка</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label">Размер</label>
                <select name="size" class="form-select">
                    <option value="">Все</option>
                    <option value="0" selected="@(Model.ViewModel.Filter.Size == 0)">Маленький</option>
                    <option value="1" selected="@(Model.ViewModel.Filter.Size == 1)">Средний</option>
                    <option value="2" selected="@(Model.ViewModel.Filter.Size == 2)">Крупный</option>
                </select>
            </div>

            <div class="col-md-1">
                <label class="form-label">Возраст от</label>
                <input type="number" name="ageFrom" class="form-control" value="@Model.ViewModel.Filter.AgeFrom" min="0" placeholder="мес." />
            </div>

            <div class="col-md-1">
                <label class="form-label">до</label>
                <input type="number" name="ageTo" class="form-control" value="@Model.ViewModel.Filter.AgeTo" min="0" placeholder="мес." />
            </div>

            <div class="col-md-2">
                <label class="form-label">Кличка</label>
                <input type="text" name="search" class="form-control" value="@Model.ViewModel.Filter.SearchQuery"/>
            </div>

            <div class="col-md-2 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary w-100">Применить</button>
                <a asp-page="/Index" class="btn btn-outline-secondary w-100">Сбросить</a>
            </div>
        </form>
    </div>
</div>

<h2 class="mb-4">Наши питомцы</h2>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-warning">@Model.ErrorMessage</div>
}

@if (!Model.ViewModel.Animals.Any())
{
    <div class="alert alert-info">Пока нет доступных животных.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var a in Model.ViewModel.Animals)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <img src="@(a.MainPhoto ?? "/images/no-photo.png")"
                         class="card-img-top" alt="@a.Name"
                         style="height:240px;object-fit:cover;"
                         onerror="this.src='/images/no-photo.png'" />
                    <div class="card-body">
                        <h5 class="card-title">@a.Name</h5>
                        <p class="card-text mb-1"><strong>@a.SpeciesText</strong>, @a.Breed</p>
                        <p class="card-text mb-1 text-muted">@a.GenderText · @a.AgeText · @a.SizeText</p>
                        <p class="card-text">@a.Description</p>
                    </div>
                    <div class="card-footer bg-white border-0">
                        <a asp-page="/Animals/Details" asp-route-id="@a.Id"
                           class="btn btn-primary w-100">Подробнее</a>
                    </div>
                </div>
            </div>
        }
    </div>
}